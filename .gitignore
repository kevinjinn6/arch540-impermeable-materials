# Python environment -- recreate with: python3 -m venv .venv
.venv/

# Downloaded open-data cache (45 MB). stormwater.py re-downloads it on first run.
cache/

# Generated outputs. Too large for GitHub and reproducible from stormwater.py.
r11_stormwater.geojson
r11_stormwater_summary.csv

# macOS
.DS_Store

# Python bytecode, created whenever the tool or its tests run
__pycache__/

# Stage 2 intermediate, reproducible from buildings.py (153 MB)
r11_stage2.geojson
# map/data/ IS committed: the published page needs it (lots 17 MB, buildings 35 MB, roof-walls 1.3 MB)

# Claude Code launch configuration (local)
.claude/

# The City's 2013 DEM (1.9 GB, over GitHub's 100 MB limit). map/terrain_tiles.py
# turns it into map/data/terrain/ (committed, about 15 MB).
DEM_2013.tif
